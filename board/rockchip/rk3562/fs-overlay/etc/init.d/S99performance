#!/bin/sh
#
# Start quectel
#
start() {
	/usr/sbin/cpufreq.sh
}

stop() {
	echo "stop"
}

case "$1" in
  start)
        start
        ;;
  stop)
        stop
        ;;
  restart|reload)
        stop
        start
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
