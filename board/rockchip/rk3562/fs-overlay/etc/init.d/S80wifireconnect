#!/bin/sh
#
# Reconnect Wifi...
#

case "$1" in
	start)
		echo "Trying to reconnect Wifi"
		killall wpa_supplicant
		rm -f /var/run/wpa_supplicant/wlan0
		sleep 1
		if [ -e /etc/wpa_supplicant.conf ]; then
			wpa_supplicant -B -Dnl80211 -c /etc/wpa_supplicant.conf -i wlan0 &
		fi
		dhclient wlan0
		;;
	stop)
		echo "Stopping WiFi connection"
    		killall wpa_supplicant
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
exit 0
